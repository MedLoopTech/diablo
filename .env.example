# ——— Supabase (supabase.com → Project Settings → API) ———
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never exposed to the client. Used for admin ops (role changes, seeding).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ——— Anthropic (console.anthropic.com) — used from Phase 2 ———
ANTHROPIC_API_KEY=sk-ant-...

# ——— Cron (Vercel Cron calls these with Authorization: Bearer <CRON_SECRET>) ———
# Required — every /api/cron/* route rejects requests outright when this is
# unset, so an unset value means the cron job simply never runs, not that
# auth is skipped.
CRON_SECRET=

# ——— Site URL (used for SEO: metadataBase, sitemap.xml, robots.txt, OG tags) ———
# No trailing slash. Defaults to the current Vercel deployment URL if unset.
NEXT_PUBLIC_SITE_URL=https://loop90.getmedloop.com

# ——— Demo mode ———
# /demo and /api/demo-login sign into a seeded @sehat90.app account with no
# password. Off automatically in production, on everywhere else. Set to "true"
# to deliberately keep the demo reachable on a production build (a sales
# deployment); "false" to force it off anywhere.
# DEMO_MODE=true
